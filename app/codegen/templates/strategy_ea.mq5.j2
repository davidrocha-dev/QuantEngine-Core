//+------------------------------------------------------------------+
//| {{ hash_id }} - generated by QuantEngine                          |
//| Genome: {{ genome_summary }}
//| Market: {{ symbol }} {{ timeframe }}                              |
//|                                                                   |
//| Generated from the same genome the backtester ran. Entries are    |
//| evaluated on CLOSED bars only (shift 1), stops and targets are    |
//| ATR multiples of the signal bar, and size comes from risking      |
//| RiskPercent of equity over the stop distance - the same rules as  |
//| engine/app/engine/backtest.py. Do not hand-edit: re-export.       |
//+------------------------------------------------------------------+
#property copyright "QuantEngine"
#property version   "1.00"
#property strict

#include <Trade/Trade.mqh>

input double RiskPercent      = {{ risk_pct }};   // % of equity risked per trade
input string RiskOverrideFile = "quantengine_risk.csv";  // COMMON Files; written by the Incubation ladder
input double MaxSpreadPoints  = {{ max_spread_points }};  // skip entries above this spread
input long   MagicNumber      = {{ magic }};
input bool   AllowLong        = true;
input bool   AllowShort       = true;
// The hours and weekdays this strategy was bred on are UTC. TimeCurrent()
// is the broker's clock, and TimeGMT() is not reliable in the Strategy
// Tester - a run on an IC Markets EU server (UTC+3 in summer) behaved
// exactly as if this were three hours off, firing FRIDAY PROFIT 45 times
// where the engine fires it 12. AUTO reads the terminal, which is right
// live and can be wrong in the tester: set it by hand when you backtest.
input int    ServerGmtOffsetHours = 99;   // 99 = auto; else the server's offset from UTC

CTrade   Trade;
datetime LastBarTime = 0;
int GmtOffsetSeconds = 0;   // resolved in OnInit

// Every rule that reads an hour or a weekday goes through this.
datetime UtcNow() { return TimeCurrent() - GmtOffsetSeconds; }
{% if execution == "MARKET2" %}
int    PendingDirection      = 0;   // a MARKET2 signal waiting out confirm_bars
int    BarsUntilEntry        = 0;
double PendingStopDistance   = 0.0;
double PendingTargetDistance = 0.0;
{% endif %}

// ATR of the signal bar sizes every stop and target, exactly as the
// backtester does (DEFAULT_STOP/TARGET_ATR_MULT are genome fields now).
int h_entry_atr = INVALID_HANDLE;

// Indicator handles the genome's own genes need.
{% for name, ctor in handles.items() %}int {{ name }} = INVALID_HANDLE;
{% endfor %}

//--- Price helpers: shift 1 is the last CLOSED bar, matching the backtest.
double Cl(int shift) { return iClose(_Symbol, PERIOD_CURRENT, shift); }
double Op(int shift) { return iOpen(_Symbol, PERIOD_CURRENT, shift); }
double Hi(int shift) { return iHigh(_Symbol, PERIOD_CURRENT, shift); }
double Lo(int shift) { return iLow(_Symbol, PERIOD_CURRENT, shift); }

double Val(int handle, int buffer, int shift)
{
   double values[];
   if(handle == INVALID_HANDLE || CopyBuffer(handle, buffer, shift, 1, values) <= 0)
      return 0.0;
   return values[0];
}

double HighestHigh(int period, int startShift)
{
   double highest = -DBL_MAX;
   for(int i = startShift; i < startShift + period; i++)
      highest = MathMax(highest, Hi(i));
   return highest;
}

double LowestLow(int period, int startShift)
{
   double lowest = DBL_MAX;
   for(int i = startShift; i < startShift + period; i++)
      lowest = MathMin(lowest, Lo(i));
   return lowest;
}

bool BullishEngulfing(int shift)
{
   return Cl(shift) > Op(shift) && Cl(shift + 1) < Op(shift + 1)
       && Op(shift) <= Cl(shift + 1) && Cl(shift) >= Op(shift + 1);
}

bool BearishEngulfing(int shift)
{
   return Cl(shift) < Op(shift) && Cl(shift + 1) > Op(shift + 1)
       && Op(shift) >= Cl(shift + 1) && Cl(shift) <= Op(shift + 1);
}

bool IsDoji(int shift, double bodyRatio)
{
   double range = Hi(shift) - Lo(shift);
   if(range <= 0.0) return false;
   return MathAbs(Cl(shift) - Op(shift)) / range <= bodyRatio;
}

double UpperWickRatio(int shift)
{
   double body = MathAbs(Cl(shift) - Op(shift));
   if(body <= 0.0) return 0.0;
   return (Hi(shift) - MathMax(Op(shift), Cl(shift))) / body;
}

double LowerWickRatio(int shift)
{
   double body = MathAbs(Cl(shift) - Op(shift));
   if(body <= 0.0) return 0.0;
   return (MathMin(Op(shift), Cl(shift)) - Lo(shift)) / body;
}

int BarOfDay(int shift)
{
   MqlDateTime bar; TimeToStruct(iTime(_Symbol, PERIOD_CURRENT, shift), bar);
   int count = 0;
   for(int i = shift + 1; i < shift + 1500; i++)
   {
      MqlDateTime other; TimeToStruct(iTime(_Symbol, PERIOD_CURRENT, i), other);
      if(other.day != bar.day || other.mon != bar.mon || other.year != bar.year) break;
      count++;
   }
   return count;
}

double OpeningRangeHigh(int rangeBars)
{
   int barIndex = BarOfDay(1);
   int firstBarShift = 1 + barIndex;              // shift of the day's first bar
   double highest = -DBL_MAX;
   for(int i = 0; i < rangeBars; i++)
      highest = MathMax(highest, Hi(firstBarShift - i));
   return highest;
}

double OpeningRangeLow(int rangeBars)
{
   int barIndex = BarOfDay(1);
   int firstBarShift = 1 + barIndex;
   double lowest = DBL_MAX;
   for(int i = 0; i < rangeBars; i++)
      lowest = MathMin(lowest, Lo(firstBarShift - i));
   return lowest;
}

double PrevDayMid()
{
   double high = iHigh(_Symbol, PERIOD_D1, 1);
   double low  = iLow(_Symbol, PERIOD_D1, 1);
   return (high + low) / 2.0;
}

double TodayRange()
{
   return iHigh(_Symbol, PERIOD_D1, 0) - iLow(_Symbol, PERIOD_D1, 0);
}

double AverageDailyRange(int period)
{
   double total = 0.0;
   for(int i = 1; i <= period; i++)
      total += iHigh(_Symbol, PERIOD_D1, i) - iLow(_Symbol, PERIOD_D1, i);
   return total / period;
}

double SessionVwap(int shift)
{
   int barIndex = BarOfDay(shift);
   double cumulativePv = 0.0, cumulativeVolume = 0.0;
   for(int i = shift; i <= shift + barIndex; i++)
   {
      double typical = (Hi(i) + Lo(i) + Cl(i)) / 3.0;
      double volume  = (double)iTickVolume(_Symbol, PERIOD_CURRENT, i);
      cumulativePv += typical * volume;
      cumulativeVolume += volume;
   }
   if(cumulativeVolume <= 0.0) return Cl(shift);
   return cumulativePv / cumulativeVolume;
}

bool AtrDeclining(int handle, int lookback)
{
   for(int i = 1; i <= lookback; i++)
      if(Val(handle, 0, i) >= Val(handle, 0, i + 1)) return false;
   return true;
}

double AverageAtr(int handle, int period)
{
   double total = 0.0;
   for(int i = 1; i <= period; i++) total += Val(handle, 0, i);
   return total / period;
}

// UtcNow, not TimeCurrent, in every rule that reads a weekday or an
// hour: the bars these genes were bred against are UTC and the broker's
// clock is not. A UTC+3 server starts Friday on Thursday evening and
// reaches lock_hour three hours early: replaying this strategy that way
// moved its Friday entries from 64 to 96.
bool IsFridayAfter(int cutoffHour)
{
   MqlDateTime now; TimeToStruct(UtcNow(), now);
   return now.day_of_week == 5 && now.hour >= cutoffHour;
}

ENUM_TIMEFRAMES HigherTimeframe() { return {{ higher_timeframe }}; }

double HtfClose(int shift) { return iClose(_Symbol, HigherTimeframe(), shift); }

int ConsecutiveLosses()
{
   int losses = 0;
   if(!HistorySelect(0, TimeCurrent())) return 0;
   for(int i = HistoryDealsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = HistoryDealGetTicket(i);
      if(HistoryDealGetInteger(ticket, DEAL_MAGIC) != MagicNumber) continue;
      if(HistoryDealGetInteger(ticket, DEAL_ENTRY) != DEAL_ENTRY_OUT) continue;
      if(HistoryDealGetDouble(ticket, DEAL_PROFIT) >= 0) break;
      losses++;
   }
   return losses;
}

bool HasOpenPosition()
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(PositionGetTicket(i) <= 0) continue;
      if(PositionGetInteger(POSITION_MAGIC) == MagicNumber && PositionGetString(POSITION_SYMBOL) == _Symbol)
         return true;
   }
   return false;
}

//+------------------------------------------------------------------+
//| A pending order is not yet a position, and checking only for      |
//| positions is how this EA came to trade a multiple of what was     |
//| backtested. LIMIT/LIMIT2/STOP entries sit unfilled for up to      |
//| PENDING_ORDER_WINDOW_BARS bars. While one waited, HasOpenPosition |
//| stayed false, so every further bar whose signal still held placed |
//| another order on top - several then filled, giving simultaneous   |
//| positions at full risk each.                                      |
//|                                                                   |
//| The backtester has exactly one order in flight: after a fill it   |
//| resumes at the bar following the exit, and after an expiry it     |
//| moves on one bar (app/engine/backtest.py, `i = exit_idx + 1`).    |
//+------------------------------------------------------------------+
bool HasPendingOrder()
{
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      if(OrderGetTicket(i) == 0) continue;
      if(OrderGetInteger(ORDER_MAGIC) == MagicNumber && OrderGetString(ORDER_SYMBOL) == _Symbol)
         return true;
   }
   return false;
}

//+------------------------------------------------------------------+
//| REQ-PORT-3 - the Incubation ladder's share of target risk, read   |
//| from a file QuantEngine writes (magic,share per line). Read at    |
//| entry time only, so a promotion applies to NEW trades and never   |
//| touches a position already open (REQ-PORT-3.7).                   |
//|                                                                   |
//| A missing or unreadable file means full target risk: the EA must  |
//| not stop trading because the app is closed.                       |
//+------------------------------------------------------------------+
double RiskShare()
{
   int handle = FileOpen(RiskOverrideFile, FILE_READ | FILE_CSV | FILE_ANSI | FILE_COMMON, ',');
   if(handle == INVALID_HANDLE) return 1.0;

   double share = 1.0;
   while(!FileIsEnding(handle))
   {
      long magic = StringToInteger(FileReadString(handle));
      double value = StringToDouble(FileReadString(handle));
      if(magic == MagicNumber && value > 0.0 && value <= 1.0)
      {
         share = value;
         break;
      }
   }
   FileClose(handle);
   return share;
}

//--- Risk sizing: a full stop-out costs exactly RiskPercent of equity,
//--- scaled by whatever stage the Incubation ladder has this bot at.
double LotsForRisk(double stopDistance)
{
   if(stopDistance <= 0.0) return 0.0;
   double riskAmount = AccountInfoDouble(ACCOUNT_EQUITY) * RiskPercent * RiskShare() / 100.0;
   double tickValue  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickSize   = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   if(tickValue <= 0.0 || tickSize <= 0.0) return 0.0;

   double lossPerLot = (stopDistance / tickSize) * tickValue;
   if(lossPerLot <= 0.0) return 0.0;

   double lots = riskAmount / lossPerLot;
   double step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   lots = MathFloor(lots / step) * step;
   return MathMax(minLot, MathMin(maxLot, lots));
}

int Signal()
{
   bool longSignal  = {{ signal_long }};
   bool shortSignal = {{ signal_short }};
   if(longSignal && !shortSignal) return 1;
   if(shortSignal && !longSignal) return -1;
   return 0;
}

int Bias()
{
{% if has_bias %}   bool bullish = {{ bias_long }};
   bool bearish = {{ bias_short }};
   if(bullish && !bearish) return 1;
   if(bearish && !bullish) return -1;
   return 0;
{% else %}   return 0;   // no BIAS gene in this genome - never disagrees
{% endif %}}

bool Vetoed()
{
{% for veto in vetoes %}   if({{ veto }}) return true;
{% endfor %}   return false;
}

void ManageOpenPosition(bool newBar)
{
{% if management == "EOD CLOSE" %}
   if(!newBar) return;   // a bar-close decision in the backtester
   MqlDateTime now; TimeToStruct(UtcNow(), now);
   if(now.hour >= {{ management_params.close_hour | default(21) }})
      for(int i = PositionsTotal() - 1; i >= 0; i--)
      {
         ulong ticket = PositionGetTicket(i);
         if(ticket <= 0) continue;
         if(PositionGetInteger(POSITION_MAGIC) == MagicNumber && PositionGetString(POSITION_SYMBOL) == _Symbol)
            Trade.PositionClose(ticket);
      }
{% elif management == "FRIDAY PROFIT" %}
   // Without this guard the EA closes at the first profitable tick after
   // lock_hour and is then free to re-enter on the next bar, over and over.
   // A real MT5 run put ~150 entries on Fridays against ~70 on every other
   // weekday; the backtest, which only evaluates this gene when a bar
   // closes, put 55 there.
   if(!newBar) return;
   MqlDateTime now; TimeToStruct(UtcNow(), now);
   if(now.day_of_week == 5 && now.hour >= {{ management_params.lock_hour | default(18) }})
      for(int i = PositionsTotal() - 1; i >= 0; i--)
      {
         ulong ticket = PositionGetTicket(i);
         if(ticket <= 0) continue;
         if(PositionGetInteger(POSITION_MAGIC) != MagicNumber || PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
         if(PositionGetDouble(POSITION_PROFIT) > 0)   // only locks a position in profit
            Trade.PositionClose(ticket);
      }
{% elif management == "PARTIAL TP" %}
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetInteger(POSITION_MAGIC) != MagicNumber || PositionGetString(POSITION_SYMBOL) != _Symbol) continue;

      double entry = PositionGetDouble(POSITION_PRICE_OPEN);
      double stop  = PositionGetDouble(POSITION_SL);
      double volume = PositionGetDouble(POSITION_VOLUME);
      if(stop <= 0.0) continue;

      double stopDistance = MathAbs(entry - stop);
      int direction = PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY ? 1 : -1;
      double current = direction > 0 ? SymbolInfoDouble(_Symbol, SYMBOL_BID) : SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      double rMultiple = (current - entry) * direction / stopDistance;

      // Bank close_fraction at r_multiple R, then move the rest to breakeven.
      if(rMultiple >= {{ management_params.r_multiple | default(1.0) }} && MathAbs(stop - entry) > _Point)
      {
         double step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
         double partial = MathFloor(volume * {{ management_params.close_fraction | default(0.5) }} / step) * step;
         if(partial >= SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN))
            Trade.PositionClosePartial(ticket, partial);
         Trade.PositionModify(ticket, entry, PositionGetDouble(POSITION_TP));
      }
   }
{% else %}
   // This genome has no MANAGEMENT gene: stop and target alone close it.
{% endif %}}

void PlaceMarketOrder(int direction, double stopDistance, double targetDistance)
{
   double lots = LotsForRisk(stopDistance);
   if(lots <= 0.0) return;
   double price = direction > 0 ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double stop   = price - direction * stopDistance;
   double target = price + direction * targetDistance;
   if(direction > 0) Trade.Buy(lots, _Symbol, price, stop, target);
   else              Trade.Sell(lots, _Symbol, price, stop, target);
}

void TryEnter()
{
   int direction = Signal();
   if(direction == 0) return;

   int bias = Bias();
   if(bias != 0 && bias != direction) return;
   if(Vetoed()) return;
   if((direction > 0 && !AllowLong) || (direction < 0 && !AllowShort)) return;

   double spread = (double)SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);
   if(MaxSpreadPoints > 0 && spread > MaxSpreadPoints) return;

   double atr = Val(h_entry_atr, 0, 1);
   if(atr <= 0.0) return;

   double signalPrice = Cl(1);
   double stopDistance = {{ stop_atr_mult }} * atr;
   double targetDistance = {{ target_atr_mult }} * atr;
   double lots = LotsForRisk(stopDistance);
   if(lots <= 0.0) return;

{% if execution == "MARKET2" %}
   // MARKET2 - the genome asks for {{ confirm_bars }} bar(s) between the
   // signal and the fill, and the backtester fills at the open of the bar
   // that many later, sizing the stop and target from the signal bar's ATR.
   // Latch them and let OnTick count the bars down. Entering on the next
   // bar regardless, which is what this did, was 368 trades against the
   // engine's 313 over one out-of-sample window.
   PendingDirection = direction;
   PendingStopDistance = stopDistance;
   PendingTargetDistance = targetDistance;
   BarsUntilEntry = {{ confirm_bars }} - 1;
   if(BarsUntilEntry <= 0) PlaceMarketOrder(direction, stopDistance, targetDistance);
{% elif execution in ("LIMIT", "LIMIT2") %}
   // {{ execution }} - pullback entry {{ limit_offset_atr }} ATR behind the signal price.
   double entryPrice = signalPrice - direction * {{ limit_offset_atr }} * atr;
   double stop   = entryPrice - direction * stopDistance;
   double target = entryPrice + direction * targetDistance;
   datetime expiry = TimeCurrent() + {{ pending_expiry_seconds }};
   if(direction > 0) Trade.BuyLimit(lots, entryPrice, _Symbol, stop, target, ORDER_TIME_SPECIFIED, expiry);
   else              Trade.SellLimit(lots, entryPrice, _Symbol, stop, target, ORDER_TIME_SPECIFIED, expiry);
{% else %}
   // STOP - breakout entry {{ stop_offset_atr }} ATR beyond the signal price.
   double entryPrice = signalPrice + direction * {{ stop_offset_atr }} * atr;
   double stop   = entryPrice - direction * stopDistance;
   double target = entryPrice + direction * targetDistance;
   datetime expiry = TimeCurrent() + {{ pending_expiry_seconds }};
   if(direction > 0) Trade.BuyStop(lots, entryPrice, _Symbol, stop, target, ORDER_TIME_SPECIFIED, expiry);
   else              Trade.SellStop(lots, entryPrice, _Symbol, stop, target, ORDER_TIME_SPECIFIED, expiry);
{% endif %}}

int OnInit()
{
   Trade.SetExpertMagicNumber(MagicNumber);
   GmtOffsetSeconds = ServerGmtOffsetHours == 99
      ? (int)(TimeCurrent() - TimeGMT())
      : ServerGmtOffsetHours * 3600;
   if(MQLInfoInteger(MQL_TESTER) && ServerGmtOffsetHours == 99 && GmtOffsetSeconds == 0)
      Print("QuantEngine: the terminal reports no GMT offset, which is usual in the tester. ",
            "If this broker's server is not on UTC, set ServerGmtOffsetHours or every ",
            "hour-of-day and day-of-week rule in this strategy will fire at the wrong time.");
   h_entry_atr = iATR(_Symbol, PERIOD_CURRENT, 14);
   if(h_entry_atr == INVALID_HANDLE) return INIT_FAILED;
{% for name, ctor in handles.items() %}
   {{ name }} = {{ ctor }};
   if({{ name }} == INVALID_HANDLE) return INIT_FAILED;
{% endfor %}
   return INIT_SUCCEEDED;
}

void OnDeinit(const int reason)
{
   IndicatorRelease(h_entry_atr);
{% for name, ctor in handles.items() %}   IndicatorRelease({{ name }});
{% endfor %}}

void OnTick()
{
   // The backtester evaluates the time-based management genes once per
   // closed bar and scans the bar's high and low for the price-based one.
   // ManageOpenPosition needs to know which of the two it is in.
   datetime currentBar = iTime(_Symbol, PERIOD_CURRENT, 0);
   bool newBar = currentBar != LastBarTime;

   ManageOpenPosition(newBar);

   if(!newBar) return;
   LastBarTime = currentBar;

   // One position or one waiting order at a time, as backtested.
   if(HasOpenPosition() || HasPendingOrder()) return;
{% if execution == "MARKET2" and confirm_bars > 1 %}
   // A latched signal is not re-tested while it waits out its confirmation
   // bars, exactly as _resolve_entry does not re-test it.
   if(BarsUntilEntry > 0)
   {
      BarsUntilEntry--;
      if(BarsUntilEntry == 0)
         PlaceMarketOrder(PendingDirection, PendingStopDistance, PendingTargetDistance);
      return;
   }
{% endif %}
   TryEnter();
}
